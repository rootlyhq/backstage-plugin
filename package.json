{
  "name": "@rootly/backstage-plugin",
  "version": "1.4.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha/index.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "rootly",
    "pluginPackages": [
      "@rootly/backstage-plugin"
    ]
  },
  "homepage": "https://github.com/rootlyhq/backstage-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rootlyhq/backstage-plugin.git",
    "directory": "."
  },
  "keywords": [
    "backstage",
    "plugin",
    "rootly"
  ],
  "jest": {
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 60,
        "lines": 75,
        "statements": 75
      }
    }
  },
  "prettier": "@backstage/cli/config/prettier",
  "sideEffects": false,
  "scripts": {
    "start": "backstage-cli package start --config ./dev/app-config.yaml",
    "build": "yarn tsc && backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "test:e2e": "playwright test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/catalog-model": "^1.10.1",
    "@backstage/core-compat-api": "^0.5.15",
    "@backstage/core-components": "^0.18.14",
    "@backstage/core-plugin-api": "^1.12.10",
    "@backstage/frontend-plugin-api": "^0.18.1",
    "@backstage/plugin-catalog-react": "^3.2.3",
    "@backstage/plugin-search-react": "^1.11.8",
    "@backstage/theme": "^0.7.3",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@material-ui/lab": "4.0.0-alpha.61",
    "@rootly/backstage-plugin-common": "^1.6.0",
    "chart.js": "^4.6.1",
    "chartkick": "^5.0.1",
    "contrast-color": "^1.0.1",
    "moment": "^2.31.0",
    "react-chartkick": "^0.5.4",
    "react-use": "^17.6.1"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router": "^6.30.2",
    "react-router-dom": "^6.30.2"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.6",
    "@backstage/cli-defaults": "^0.1.6",
    "@backstage/config-loader": "^1.11.3",
    "@backstage/core-app-api": "^1.20.5",
    "@backstage/dev-utils": "^1.1.27",
    "@backstage/frontend-defaults": "^0.5.6",
    "@backstage/frontend-test-utils": "^0.6.4",
    "@backstage/plugin-catalog": "^2.0.9",
    "@backstage/plugin-search": "^1.7.8",
    "@backstage/test-utils": "^1.7.22",
    "@jest/environment-jsdom-abstract": "^30.5.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/contrast-color": "^1.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jest": "^30.5.2",
    "jest-canvas-mock": "^2.5.8",
    "jest-fetch-mock": "^4.2.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^6.30.6",
    "react-router-dom": "^6.30.6",
    "typescript": "~5.8.3"
  },
  "files": [
    "dist",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts",
  "packageManager": "yarn@4.13.0",
  "resolutions": {
    "@octokit/plugin-paginate-rest": "^9.2.2",
    "@octokit/request": "^8.4.1",
    "@octokit/request-error": "^5.1.1",
    "adm-zip": "^0.6.0",
    "fast-uri": "^3.1.4",
    "qs": "^6.16.0",
    "brace-expansion": "^5.0.8",
    "prismjs": "^1.30.0",
    "undici": "^7.28.0",
    "ws": "^8.20.1",
    "webpack-dev-server": "^5.2.6",
    "@yarnpkg/core/got": "^11.8.6"
  }
}
